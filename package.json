  },
  "license": "MIT",
  "homepage": "https://github.com/AhmedMoharam/signal-bridge#readme",
  "bugs": {
    "url": "https://github.com/AhmedMoharam/signal-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedMoharam/signal-bridge.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
